# dependencies
node_modules/
.pnp
.pnp.js

# next.js
.next/
out/
build/
dist/

# env — never commit
.env
.env.local
.env.production
.env*.local

# uploads (product images, order reference images) — never commit customer data.
# Anchored at repo root: an unanchored "uploads/" also matches app/uploads/
# and lib/uploads/ (the auth-checked serving route and its storage helper),
# silently excluding real source code, not just the runtime file store.
/public/uploads/
/uploads/

# database
*.db
*.sqlite
prisma/*.db

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# os / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# misc
*.pem
.vercel
.turbo
coverage/
backups/
*.tsbuildinfo

# stray agent worktrees (contain their own nested .git — never vendor these in)
.claude/worktrees/
