// Antu Boutique CRM — Prisma schema
// Phase 0: AUTH & ORG tables only. See PRD.md §5 for the full data model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_URL")
  // Throwaway `antu_shadow` database. Prisma WIPES the shadow database
  // before replaying migrations into it — it must never be DATABASE_URL or
  // DIRECT_URL (see CLAUDE.md, non-negotiable rule 11).
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum RoleName {
  ADMIN
  MANAGER
  TEAM_LEADER
  SALES_EXECUTIVE
  PACKING
  ACCOUNTS
  POS_OPERATOR
}

enum OverrideEffect {
  GRANT
  REVOKE
}

enum CustomerTag {
  VIP
  WHOLESALE
  PROBLEM_CUSTOMER
}

enum OrderChannel {
  ONLINE
  WALK_IN
}

// PRD §4.6 lifecycle. P1.3 only ever writes LEAD/CONFIRMED (see
// lib/orders/order-number.ts and the order-create route) — the rest of the
// funnel, illegal-transition guarding and the edit-window/approval gate are
// P1.4. The enum is defined in full now so order_status_history and the
// detail page don't need a schema change when P1.4 lands.
enum OrderStatus {
  LEAD
  CONFIRMED
  PACKED
  HANDED_TO_COURIER
  IN_TRANSIT
  DELIVERED
  COMPLETED
  ON_HOLD
  CANCELLED
  RETURNED
  REFUNDED
  EXCHANGE_REQUESTED
  // P2.2 — the courier delivered part of the parcel (customer kept some
  // items, sent the rest back with the rider). Only ever set by the courier
  // sync (lib/courier/sync.ts), never by the generic status route.
  PARTIAL_DELIVERED
}

// PRD §4.9 courier zone tiers.
enum DeliveryZone {
  INSIDE_CITY
  SUB_CITY
  OUTSIDE_CITY
}

enum PaymentMethod {
  BKASH
  NAGAD
  ROCKET
  BANK
  CASH
  CARD
  // P2.2b — COD the courier collected at the door and paid out to us,
  // settled from a reconciled courier statement.
  COURIER_COD
  // P3.2 — no money moves: the value of items returned in an exchange,
  // carried from the original order to its replacement (kind EXCHANGE_CREDIT).
  EXCHANGE_CREDIT
  // P3.2 — the customer's store credit (kind STORE_CREDIT): spent on an
  // order, or issued from one. No wallet — the money is already in the shop.
  STORE_CREDIT
}

// PRD §4.6 edit window: PENDING until a TL/Admin acts on it, then terminal.
enum OrderEditRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Team {
  id        String     @id @default(cuid())
  name      String
  leaderId  String?    @unique
  leader    User?      @relation("TeamLeader", fields: [leaderId], references: [id])
  members   User[]     @relation("TeamMembers")
  customers Customer[] @relation("CustomerTeam")
  orders    Order[]    @relation("OrderTeam")
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("teams")
}

model Role {
  id          String           @id @default(cuid())
  name        RoleName         @unique
  label       String
  description String?
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("roles")
}

model Permission {
  id          String                   @id @default(cuid())
  key         String                   @unique
  group       String
  label       String
  description String?
  roles       RolePermission[]
  overrides   UserPermissionOverride[]
  createdAt   DateTime                 @default(now())

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserPermissionOverride {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission     @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  effect       OverrideEffect @default(GRANT)
  reason       String?
  createdAt    DateTime       @default(now())

  @@unique([userId, permissionId])
  @@map("user_permission_overrides")
}

model User {
  id                        String                   @id @default(cuid())
  name                      String
  phone                     String                   @unique
  email                     String?                  @unique
  passwordHash              String
  avatarUrl                 String?
  roleId                    String
  role                      Role                     @relation(fields: [roleId], references: [id])
  teamId                    String?
  team                      Team?                    @relation("TeamMembers", fields: [teamId], references: [id])
  ledTeam                   Team?                    @relation("TeamLeader")
  isActive                  Boolean                  @default(true)
  mustChangePassword        Boolean                  @default(true)
  failedLoginCount          Int                      @default(0)
  lockedUntil               DateTime?
  lastLoginAt               DateTime?
  joinDate                  DateTime                 @default(now())
  permissionOverrides       UserPermissionOverride[]
  auditLogs                 AuditLog[]
  createdProducts           Product[]                @relation("ProductCreatedBy")
  createdCustomers          Customer[]               @relation("CustomerCreatedBy")
  createdOrders             Order[]                  @relation("OrderCreatedBy")
  uploadedOrderImages       OrderImage[]             @relation("OrderImageUploadedBy")
  orderStatusChanges        OrderStatusHistory[]     @relation("OrderStatusChangedBy")
  receivedPayments          Payment[]                @relation("PaymentReceivedBy")
  requestedOrderEdits       OrderEditRequest[]       @relation("OrderEditRequestedBy")
  reviewedOrderEdits        OrderEditRequest[]       @relation("OrderEditReviewedBy")
  generatedInvoices         Invoice[]                @relation("InvoiceGeneratedBy")
  updatedSettings           Setting[]                @relation("SettingUpdatedBy")
  stockMovements            StockMovement[]          @relation("StockMovementActor")
  createdPurchases          Purchase[]               @relation("PurchaseCreatedBy")
  createdExpenses           Expense[]                @relation("ExpenseCreatedBy")
  bookedShipments           Shipment[]               @relation("ShipmentBookedBy")
  accountsReviewedShipments Shipment[]               @relation("ShipmentAccountsReviewedBy")
  inspectedReturns          ReturnInspection[]       @relation("ReturnInspectedBy")
  keptItemsMarked           ReturnInspection[]       @relation("ReturnKeptItemsMarkedBy")
  createdStatements         CourierStatement[]       @relation("CourierStatementCreatedBy")
  resolvedStatementLines    CourierStatementLine[]   @relation("CourierStatementLineResolvedBy")
  verifiedPayments          Payment[]                @relation("PaymentVerifiedBy")
  decidedRefunds            Payment[]                @relation("RefundDecidedBy")
  walletEntries             WalletEntry[]            @relation("WalletEntryCreatedBy")
  adSpends                  DailyAdSpend[]           @relation("AdSpendCreatedBy")
  openedCashDrawers         CashDrawer[]             @relation("CashDrawerOpenedBy")
  closedCashDrawers         CashDrawer[]             @relation("CashDrawerClosedBy")
  requestedReturnCases      ReturnCase[]             @relation("ReturnCaseRequestedBy")
  decidedReturnCases        ReturnCase[]             @relation("ReturnCaseDecidedBy")
  cancelledReturnCases      ReturnCase[]             @relation("ReturnCaseCancelledBy")
  storeCreditEntries        StoreCreditEntry[]       @relation("StoreCreditEntryCreatedBy")
  createdOutfitSets         OutfitSet[]              @relation("OutfitSetCreatedBy")
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  @@map("users")
}

// Lightweight catalog master lists, seeded in Phase 0 so Settings and the
// seed script have something to point at. Product/Variant land in Phase 1.
model Size {
  id        String           @id @default(cuid())
  name      String           @unique
  // SKU code, 1–3 capital letters/digits (Free → F, XL → XL). See Color.code.
  code      String           @unique
  sortOrder Int              @default(0)
  isActive  Boolean          @default(true)
  variants  ProductVariant[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("sizes")
}

model Color {
  id        String           @id @default(cuid())
  name      String           @unique
  // SKU code, 2–3 capital letters/digits (Maroon → MRN, Mustard Yellow → MYL).
  // SKU = product code + size code + colour code, at most 9 characters, so
  // every price tag scans reliably on a 38 mm label (lib/catalog/codes.ts).
  code      String           @unique
  hexCode   String
  sortOrder Int              @default(0)
  isActive  Boolean          @default(true)
  variants  ProductVariant[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("colors")
}

model Category {
  id        String     @id @default(cuid())
  name      String
  parentId  String?
  parent    Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryParent")
  products  Product[]
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("categories")
}

// PRD §4.2 — the garment. Cost never lives here (only on the variant, via
// weighted_avg_cost) so stripCostFieldsForUser only ever has to scrub one level.
model Product {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String
  categoryId  String?
  category    Category?   @relation(fields: [categoryId], references: [id])
  brand       String?
  description String?
  fabric      String?
  basePrice   Decimal     @db.Decimal(12, 2)
  tags        String[]    @default([])
  isActive    Boolean     @default(true)
  // P3.3 — COMPONENT_ONLY: packaging material (branded bag, box, tissue,
  // tag). Stocked and costed like any product, never sold on its own, no
  // selling price (DB CHECK), hidden from order and POS search.
  kind        ProductKind @default(SELLABLE)

  images        ProductImage[]
  variants      ProductVariant[]
  // P3.3 — sets this product is a component of, and the packaging each
  // unit of it uses.
  setComponents OutfitSetComponent[]
  packaging     PackagingComponent[] @relation("ProductPackaging")

  createdById String?
  createdBy   User?   @relation("ProductCreatedBy", fields: [createdById], references: [id])

  // CLAUDE.md rule 8: soft delete only. Excluded from every list/detail
  // query via `deletedAt: null`; purged by the trash cron after 30 days.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([deletedAt])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  filePath  String
  thumbPath String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

// PRD §4.2 — what actually has stock and a sellable price. `stockQty` is
// only ever moved by lib/inventory/ledger.ts's recordStockMovement, which
// writes the stock_movements row in the same transaction (CLAUDE.md rule 2).
// The DB backs this up: a deferred constraint trigger (migration
// 20260923081635_stock_ledger_purchases) rejects any COMMIT where stockQty
// differs from sum(stock_movements.qty) for that variant. `reservedQty` is a counter,
// not a movement — reserving/releasing it never writes a ledger row.
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sizeId    String
  size      Size    @relation(fields: [sizeId], references: [id])
  colorId   String
  color     Color   @relation(fields: [colorId], references: [id])

  sku          String    @unique
  // Locked once its first price tag is printed (tagPrintedAt set): a printed
  // tag carries this SKU for good. Kept equal to (tagPrintedAt IS NOT NULL)
  // by a DB CHECK; a trigger refuses any SKU change after that.
  skuLocked    Boolean   @default(false)
  tagPrintedAt DateTime?

  stockQty          Int      @default(0)
  reservedQty       Int      @default(0)
  weightedAvgCost   Decimal  @default(0) @db.Decimal(12, 2)
  priceOverride     Decimal? @db.Decimal(12, 2)
  lowStockThreshold Int?
  // P2.2 — optional parcel weight per unit, in grams (integer, never a
  // float). Summed per order to pre-fill the courier cost estimate.
  weightGrams       Int?
  isActive          Boolean  @default(true)

  orderItems     OrderItem[]
  stockMovements StockMovement[]
  // P3.3 — where this variant (of a COMPONENT_ONLY product) is used as packaging.
  packagingUses  PackagingComponent[] @relation("PackagingMaterial")
  purchaseItems  PurchaseItem[]
  // P3.2 — exchange lines that swap an item for this variant.
  exchangeLines  ReturnCaseLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, sizeId, colorId])
  @@index([productId])
  @@index([sizeId])
  @@index([colorId])
  @@map("product_variants")
}

// PRD §4.4 — one person per customer: the buyer is the recipient, so there
// is no payer/recipient split, no second phone, no country field. `teamId`
// is denormalized from the creator at insert time (not derived via a join)
// so the shared lib/auth/scope.ts helper can filter a TEAM_LEADER's list
// with a single indexed where clause, same as every other scoped module.
model Customer {
  id            String        @id @default(cuid())
  name          String
  phone         String        @unique
  altPhone      String?
  division      String?
  district      String?
  thana         String?
  addressDetail String?
  notes         String?
  tags          CustomerTag[] @default([])

  createdById String?
  createdBy   User?   @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  teamId      String?
  team        Team?   @relation("CustomerTeam", fields: [teamId], references: [id])

  orders             Order[]
  // P3.2 — store credit. The balance is never stored: it is derived from
  // these rows (lib/store-credit/ledger.ts).
  storeCreditEntries StoreCreditEntry[]

  // CLAUDE.md rule 8: soft delete only. Excluded from every list/detail
  // query via `deletedAt: null`; purged by the trash cron after 30 days.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
  @@index([teamId])
  @@index([deletedAt])
  @@map("customers")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

// PRD §4.9 — minimal courier + per-zone charge, just enough for the order
// form's "courier + zone + delivery charge auto-filled" (§4.6 section 4).
// Phase 2 (P2.2) extends CourierCompany with Steadfast credentials,
// consignment tracking and COD reconciliation without touching this shape.
model CourierCompany {
  id          String              @id @default(cuid())
  name        String              @unique
  contact     String?
  // P2.2 — which API integration (if any) drives this courier. The schema
  // stays multi-courier; only Steadfast has an integration today.
  provider    CourierProvider?    @unique
  isActive    Boolean             @default(true)
  zones       CourierZone[]
  costRates   CourierCostRate[]
  statements  CourierStatement[]
  integration CourierIntegration?
  shipments   Shipment[]
  orders      Order[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@map("courier_companies")
}

model CourierZone {
  id               String         @id @default(cuid())
  courierId        String
  courier          CourierCompany @relation(fields: [courierId], references: [id], onDelete: Cascade)
  zone             DeliveryZone
  charge           Decimal        @default(0) @db.Decimal(10, 2)
  codChargePercent Decimal        @default(0) @db.Decimal(5, 2)
  returnCharge     Decimal        @default(0) @db.Decimal(10, 2)
  orders           Order[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([courierId, zone])
  @@map("courier_zones")
}

// Atomic counter behind AB-YYMM-NNNN order numbers (CLAUDE.md conventions).
// One row per calendar month; lib/orders/order-number.ts increments it
// inside the same transaction as the order insert so two concurrent orders
// in the same month can never collide (Postgres row-locks the upsert).
model OrderSequence {
  yearMonth  String @id
  lastNumber Int    @default(0)

  @@map("order_sequences")
}

// PRD §4.6 — the order screen. `status` only ever reaches LEAD/CONFIRMED
// from this phase's create/edit routes; the rest of OrderStatus is reserved
// for P1.4 (lifecycle transitions) and P1.6 (packing). `dueAmount` is a
// server-recomputed cache (CLAUDE.md rule 1) — never write it from a client
// value; see lib/orders/totals.ts, the only place allowed to set it.
model Order {
  id      String       @id @default(cuid())
  orderNo String       @unique
  channel OrderChannel @default(ONLINE)
  status  OrderStatus  @default(CONFIRMED)

  // P3.1 — null only for an anonymous walk-in (POS) sale. Every ONLINE
  // order has one person (PRD §4.6); a walk-in who gives a phone number is
  // linked to their customer record for repeat tracking (PRD §4.7).
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)

  courierId            String?
  courier              CourierCompany? @relation(fields: [courierId], references: [id])
  courierZoneId        String?
  courierZone          CourierZone?    @relation(fields: [courierZoneId], references: [id])
  deliveryCharge       Decimal         @default(0) @db.Decimal(10, 2)
  expectedDeliveryDate DateTime?

  subtotal      Decimal @default(0) @db.Decimal(12, 2)
  discountTotal Decimal @default(0) @db.Decimal(12, 2)
  total         Decimal @default(0) @db.Decimal(12, 2)
  dueAmount     Decimal @default(0) @db.Decimal(12, 2)

  internalNote String?
  // P2.2 — delivery instructions for the rider ("call before coming", "gate
  // 3"). This, and ONLY this, is sent as the courier consignment `note` —
  // internalNote is staff-only and must never leave the building.
  deliveryNote String?

  createdById String?
  createdBy   User?   @relation("OrderCreatedBy", fields: [createdById], references: [id])
  // Denormalized from the creator at insert time, same pattern as
  // Customer.teamId — lets scopedWhere() filter a TEAM_LEADER's order list
  // with a single indexed column, no join.
  teamId      String?
  team        Team?   @relation("OrderTeam", fields: [teamId], references: [id])

  // P3.2 (PRD §4.11) — set on the replacement order an exchange creates;
  // points back at the order whose item is being exchanged.
  exchangedFromOrderId String?
  exchangedFrom        Order?  @relation("OrderExchange", fields: [exchangedFromOrderId], references: [id], onDelete: Restrict)
  exchangeOrders       Order[] @relation("OrderExchange")

  items              OrderItem[]
  images             OrderImage[]
  payments           Payment[]
  statusHistory      OrderStatusHistory[]
  editRequests       OrderEditRequest[]
  invoices           Invoice[]
  shipment           Shipment?
  returnInspections  ReturnInspection[]
  statementLines     CourierStatementLine[]
  returnCases        ReturnCase[]           @relation("ReturnCaseOrder")
  storeCreditEntries StoreCreditEntry[]
  // P3.3 — outfit sets on this order (their components are ordinary items).
  setLines           OrderSetLine[]
  // P3.3 — the one "Packaging used" expense this order posted.
  packagingExpense   Expense?               @relation("PackagingExpense")
  replacementFor     ReturnCase?            @relation("ReturnCaseReplacement")

  // CLAUDE.md rule 8: soft delete only.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([createdById])
  @@index([teamId])
  @@index([status])
  @@index([deletedAt])
  @@index([exchangedFromOrderId])
  @@map("orders")
}

model OrderItem {
  id        String         @id @default(cuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  qty          Int
  unitPrice    Decimal @db.Decimal(12, 2)
  lineDiscount Decimal @default(0) @db.Decimal(12, 2)

  // CLAUDE.md rule 3: frozen at PACKED (P1.6), never touched after. Null
  // until then, so today's cost never leaks into an unpacked order's response.
  unitCostSnapshot Decimal? @db.Decimal(12, 2)

  // PRD §4.6 section 2: selling below available stock is blocked unless
  // ADMIN/MANAGER overrides with a reason (order.stock_override permission).
  stockOverride       Boolean @default(false)
  stockOverrideReason String?

  // P2.2 partial delivery — how many units of this line the customer sent
  // back with the rider. The order total is recomputed on the kept quantity
  // (lib/courier/partial-delivery.ts); qty itself never changes.
  returnedQty Int @default(0)

  // P3.3 — set when this line is one component of an outfit set on the
  // order: the chosen size/colour of that component, with its share of the
  // set's price. Stock, cost, packing and returns treat it like any line.
  setLineId String?
  setLine   OrderSetLine? @relation(fields: [setLineId], references: [id], onDelete: Cascade)

  images                OrderImage[]
  returnInspectionLines ReturnInspectionLine[]
  returnCaseLines       ReturnCaseLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([variantId])
  @@index([setLineId])
  @@map("order_items")
}

// PRD §5.1 — the new table. Soft-deletable and audit-logged on every
// add/replace/delete per §4.6 section 3; never blocks order creation.
model OrderImage {
  id          String     @id @default(cuid())
  orderId     String
  order       Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId String?
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  filePath  String
  thumbPath String
  caption   String?
  mimeType  String
  sizeBytes Int

  uploadedById String?
  uploadedBy   User?    @relation("OrderImageUploadedBy", fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())

  deletedAt DateTime?

  @@index([orderId])
  @@index([orderItemId])
  @@map("order_images")
}

model OrderStatusHistory {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  changedById String?
  changedBy   User?        @relation("OrderStatusChangedBy", fields: [changedById], references: [id])
  note        String?
  createdAt   DateTime     @default(now())

  @@index([orderId])
  @@map("order_status_history")
}

// PRD §4.10 — the advance payment is recorded at order creation; P1.5 adds
// the standalone create/edit/delete/verify routes on top of this same
// table. `transactionId`'s `@unique` is a nullable unique index, which
// Postgres treats as unique-among-non-null-values — exactly CLAUDE.md rule
// 4's "globally unique where not null", no extra constraint needed.
// P2.3: `walletId` links the Wallet that received the money (e.g. "bKash
// Personal" vs "bKash Merchant"); the old free-text `wallet` was migrated.
model Payment {
  id            String        @id @default(cuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // P2.3: REFUND rows are negative (DB CHECK) — money going back out.
  kind          PaymentKind   @default(PAYMENT)
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  // Which wallet received (or, for a refund, paid out) the money. Always
  // null for COURIER_COD (DB CHECK): that money reaches a wallet as the
  // courier statement's net payout, never parcel by parcel.
  walletId      String?
  wallet        Wallet?       @relation(fields: [walletId], references: [id], onDelete: Restrict)
  transactionId String?       @unique
  paidAt        DateTime      @default(now())
  receivedById  String?
  receivedBy    User?         @relation("PaymentReceivedBy", fields: [receivedById], references: [id])
  verified      Boolean       @default(false)
  verifiedById  String?
  verifiedBy    User?         @relation("PaymentVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt    DateTime?
  note          String?
  // P3.1 — cash handed over at the counter, when more than `amount` (the
  // difference was given back as change). Printed on the receipt. CASH only
  // and never below the amount (DB CHECK).
  cashTendered  Decimal?      @db.Decimal(12, 2)

  // P2.3 — refunds need a reason and a second person's approval. Only an
  // APPROVED refund counts toward due_amount and the wallet balance.
  refundReason String?
  refundStatus RefundStatus?
  decidedById  String?
  decidedBy    User?         @relation("RefundDecidedBy", fields: [decidedById], references: [id])
  decidedAt    DateTime?
  decisionNote String?

  // P2.2b — set when this payment settled a courier statement line.
  courierStatementLine CourierStatementLine?

  // P3.2 — the return/exchange this row belongs to: an EXCHANGE_CREDIT
  // pair (−credit on the original, +credit on the replacement), or the
  // refund a counter exchange requested for the difference.
  returnCaseId String?
  returnCase   ReturnCase? @relation(fields: [returnCaseId], references: [id], onDelete: Restrict)

  // P3.2 — the ledger row a STORE_CREDIT payment wrote (and only those).
  storeCreditEntry StoreCreditEntry?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([walletId])
  @@index([verified])
  @@index([refundStatus])
  @@index([paidAt])
  @@index([returnCaseId])
  @@map("payments")
}

// PRD §4.6 edit window: an SE edits freely for `order_edit_window_minutes`
// (see Setting below, default 30) after order creation. Past that, a change
// to items/price/discount/delivery charge is captured here instead of being
// applied — lib/orders/apply-edit.ts validates `proposedChanges` (same shape
// as the order PATCH body) both at request time and again at approval time,
// since stock/price-floor state can drift while a request sits PENDING.
model OrderEditRequest {
  id      String                 @id @default(cuid())
  orderId String
  order   Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status  OrderEditRequestStatus @default(PENDING)

  proposedChanges Json
  // Snapshot of the order+items this request was filed against, for the
  // approval screen's before/after diff and the audit_logs "before" value.
  beforeSnapshot  Json

  requestedById String?
  requestedBy   User?   @relation("OrderEditRequestedBy", fields: [requestedById], references: [id])

  reviewedById String?
  reviewedBy   User?     @relation("OrderEditReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  reviewNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
  @@map("order_edit_requests")
}

// PRD §6 rule 8 — an approved edit regenerates the invoice as a NEW version;
// old versions are retained (never overwritten/deleted). `filePath` sits
// under UPLOAD_ROOT (orders/<order_no>/invoices/v<n>.pdf), served through
// the same auth-checked app/uploads/[...path] route as order images.
model Invoice {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  version Int

  filePath String

  generatedById String?
  generatedBy   User?   @relation("InvoiceGeneratedBy", fields: [generatedById], references: [id])

  createdAt DateTime @default(now())

  @@unique([orderId, version])
  @@map("invoices")
}

// PRD §5 SETTINGS group — a minimal key/value store so a business rule like
// the edit-window length is configurable without a code change. Phase 5
// builds the Settings screen on top of this same table; P1.4 only needs
// order_edit_window_minutes to exist and default sanely when absent.
model Setting {
  key         String   @id
  value       String
  updatedById String?
  updatedBy   User?    @relation("SettingUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt

  @@map("settings")
}

// ---------------------------------------------------------------------------
// PRD §4.3 — Inventory: suppliers, purchases and the stock ledger (P2.1)
// ---------------------------------------------------------------------------

enum StockMovementType {
  PURCHASE_IN
  SALE_OUT
  RETURN_IN
  EXCHANGE_OUT
  EXCHANGE_IN
  DAMAGE_OUT
  ADJUSTMENT
  POS_SALE_OUT
  // P3.3 — packaging material used when an order was packed or sold at the counter.
  PACKAGING_OUT
}

// What a ledger row points back to (`referenceId` is that entity's id, or
// null for OPENING_BALANCE / a manual ADJUSTMENT, where the row itself is
// the record). RETURN / EXCHANGE are reserved for P3.2.
enum StockReferenceType {
  OPENING_BALANCE
  PURCHASE
  ORDER
  ADJUSTMENT
  DAMAGE
  RETURN
  EXCHANGE
}

// How a purchase's transport/other cost is spread across its lines before
// it lands in each variant's weighted average cost.
enum CostAllocationMethod {
  BY_VALUE
  BY_QTY
}

enum ExpenseNature {
  FIXED
  VARIABLE
}

model Supplier {
  id        String     @id @default(cuid())
  name      String     @unique
  phone     String?
  address   String?
  notes     String?
  isActive  Boolean    @default(true)
  purchases Purchase[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("suppliers")
}

// PRD §4.3 purchase entry. Never deleted or re-itemised once saved — its
// lines have already moved stock and WAC; a mistake is corrected with a
// manual ADJUSTMENT. Only the payment side (amountPaid, invoiceNo, note)
// stays editable. `dueAmount` is always totalCost − amountPaid, computed
// server-side (lib/inventory/purchases.ts), never taken from the client.
model Purchase {
  id               String               @id @default(cuid())
  supplierId       String
  supplier         Supplier             @relation(fields: [supplierId], references: [id])
  purchaseDate     DateTime
  invoiceNo        String?
  allocationMethod CostAllocationMethod @default(BY_VALUE)

  itemsSubtotal Decimal @db.Decimal(12, 2)
  transportCost Decimal @default(0) @db.Decimal(12, 2)
  otherCost     Decimal @default(0) @db.Decimal(12, 2)
  totalCost     Decimal @db.Decimal(12, 2)
  amountPaid    Decimal @default(0) @db.Decimal(12, 2)
  dueAmount     Decimal @default(0) @db.Decimal(12, 2)

  note String?

  createdById String?
  createdBy   User?   @relation("PurchaseCreatedBy", fields: [createdById], references: [id])

  items PurchaseItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Same supplier invoice can't be entered twice (NULL invoiceNo is exempt —
  // Postgres treats NULLs as distinct in a unique index).
  @@unique([supplierId, invoiceNo])
  @@index([purchaseDate])
  @@map("purchases")
}

model PurchaseItem {
  id         String         @id @default(cuid())
  purchaseId String
  purchase   Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  qty            Int
  unitCost       Decimal @db.Decimal(12, 2)
  lineCost       Decimal @db.Decimal(12, 2)
  allocatedCost  Decimal @default(0) @db.Decimal(12, 2)
  landedUnitCost Decimal @db.Decimal(12, 2)

  // Frozen at save time so the purchase screen can show exactly how this
  // line moved the variant's weighted average cost.
  stockBefore Int
  wacBefore   Decimal @db.Decimal(12, 2)
  wacAfter    Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([purchaseId])
  @@index([variantId])
  @@map("purchase_items")
}

// PRD §4.3 — immutable, append-only. A BEFORE UPDATE/DELETE trigger in the
// migration rejects any change to an existing row; corrections are new
// rows. `qty` is signed (+in / −out); `stockAfter` is the variant's
// stockQty right after this row, so the ledger reads as a running balance.
// Every FK here is Restrict: a cascade/set-null would be an UPDATE/DELETE
// on the ledger, which the trigger forbids anyway.
model StockMovement {
  id               String             @id @default(cuid())
  variantId        String
  variant          ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Restrict)
  type             StockMovementType
  qty              Int
  stockAfter       Int
  unitCostSnapshot Decimal            @db.Decimal(12, 2)
  referenceType    StockReferenceType
  referenceId      String?
  note             String?

  actorId String?
  actor   User?   @relation("StockMovementActor", fields: [actorId], references: [id], onDelete: Restrict)

  expense Expense?

  createdAt DateTime @default(now())

  @@index([variantId, createdAt])
  @@index([referenceType, referenceId])
  @@index([type])
  @@index([createdAt])
  @@map("stock_movements")
}

// PRD §4.12 — only the columns P2.1 needs to post a damage write-off at
// cost. P2.3 adds the wallet it was paid from, attachments and the entry UI
// on top of this same table.
model ExpenseCategory {
  id            String        @id @default(cuid())
  name          String        @unique
  // P2.3 — the PRD §4.12 heading this category reports under.
  kind          ExpenseKind   @default(MISC)
  defaultNature ExpenseNature @default(VARIABLE)
  // Posted by the system only (courier charges, write-offs, ad spend) —
  // never picked on the expense form, so nothing is entered twice.
  isSystem      Boolean       @default(false)
  sortOrder     Int           @default(0)
  isActive      Boolean       @default(true)
  expenses      Expense[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("expense_categories")
}

model Expense {
  id          String          @id @default(cuid())
  expenseDate DateTime
  categoryId  String
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  nature      ExpenseNature
  amount      Decimal         @db.Decimal(12, 2)
  note        String?

  // P2.3 — the wallet it was paid from. Null for non-cash postings (stock
  // write-offs) and courier charges the courier deducted from its payout.
  walletId String?
  wallet   Wallet? @relation(fields: [walletId], references: [id], onDelete: Restrict)

  // Optional receipt: an image (compressed) or a PDF under expenses/<id>/.
  attachmentPath String?
  attachmentMime String?
  attachmentName String?

  // P2.3 — the posting of a daily ad spend row (edited/deleted with it).
  adSpendId String?       @unique
  adSpend   DailyAdSpend? @relation(fields: [adSpendId], references: [id], onDelete: Restrict)

  // Set when the expense was posted by a stock event rather than typed in:
  // a DAMAGE_OUT write-off, or a manual ADJUSTMENT (stock shortage, or a
  // negative credit when stock is found). Only these may be ≤ 0 (DB CHECK).
  stockMovementId String?        @unique
  stockMovement   StockMovement? @relation(fields: [stockMovementId], references: [id], onDelete: Restrict)

  // P3.1 — set when the expense is a cash drawer's day-end over/short:
  // a shortage as a cost, an overage as a credit (negative). Unique, so a
  // drawer can never post its difference twice.
  cashDrawerId String?     @unique
  cashDrawer   CashDrawer? @relation(fields: [cashDrawerId], references: [id], onDelete: Restrict)

  // P2.2 — set when the expense is the courier return charge for a returned
  // parcel, posted once when its condition check completes. Unique, so a
  // replayed check can never post the charge twice.
  returnChargeInspectionId String?           @unique
  returnChargeInspection   ReturnInspection? @relation("ReturnChargeExpense", fields: [returnChargeInspectionId], references: [id], onDelete: Restrict)
  // P3.2 — an online exchange's replacement parcel, when the company bears
  // its courier charge: posted once, under "Exchange / return cost".
  // P3.3 — the packaging an order used (bags, boxes, tissue, tags), at
  // cost, posted once when it's packed or sold at the counter.
  packagingOrderId         String?           @unique
  packagingOrder           Order?            @relation("PackagingExpense", fields: [packagingOrderId], references: [id], onDelete: Restrict)
  exchangeCourierCaseId    String?           @unique
  exchangeCourierCase      ReturnCase?       @relation("ExchangeCourierCostExpense", fields: [exchangeCourierCaseId], references: [id], onDelete: Restrict)
  statementDeliveryCharge  CourierStatement? @relation("StatementDeliveryChargeExpense")
  statementCodCharge       CourierStatement? @relation("StatementCodChargeExpense")

  createdById String?
  createdBy   User?   @relation("ExpenseCreatedBy", fields: [createdById], references: [id])

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expenseDate])
  @@index([categoryId])
  @@index([walletId])
  @@index([deletedAt])
  @@map("expenses")
}

// ---------------------------------------------------------------------------
// PRD §4.10 / §4.12 — wallets, manual wallet entries, daily ad spend (P2.3)
// ---------------------------------------------------------------------------

enum PaymentKind {
  PAYMENT
  REFUND
  // P3.2 — exchange credit moved between two orders (method EXCHANGE_CREDIT,
  // no wallet): negative on the original, positive on the replacement.
  EXCHANGE_CREDIT
  // P3.2 — store credit (method STORE_CREDIT, no wallet). Positive: credit
  // spent on this order. Negative: credit issued to the customer out of
  // what they overpaid here, or given back when the order it paid for was
  // cancelled. Every row has exactly one store_credit_entries row.
  STORE_CREDIT
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
}

// The PRD §4.12 expense headings.
enum ExpenseKind {
  AD_COST
  PURCHASE
  COURIER
  SALARY
  RENT
  UTILITY
  PACKAGING
  TRANSPORT
  EXCHANGE_RETURN
  // Stock written off at cost (DAMAGE_OUT) — its own heading so the owner
  // sees monthly damage losses, never folded into Misc.
  DAMAGE_WRITE_OFF
  // Manual stock-count adjustments at cost: a shortfall is a cost, stock
  // found later is a credit (negative), so the heading shows the net
  // unexplained loss — kept apart from damage, a different problem.
  STOCK_SHORTAGE
  // P3.1 — the showroom cash drawer's day-end difference: counted cash
  // below what the drawer should hold is a cost, above it a credit.
  CASH_OVER_SHORT
  MISC
}

enum WalletType {
  BKASH
  NAGAD
  ROCKET
  BANK
  CASH
}

enum WalletEntryType {
  MANUAL_IN
  MANUAL_OUT
  TRANSFER_IN
  TRANSFER_OUT
}

enum AdPlatform {
  FACEBOOK
  INSTAGRAM
  TIKTOK
  GOOGLE
  OTHER
}

// A wallet has no stored balance. Its balance is always derived
// (lib/wallets/ledger.ts): opening balance + verified payments − approved
// refunds − expenses paid from it ± manual entries + courier payouts into it,
// all dated on/after openingDate. Nothing can drift out of step.
model Wallet {
  id             String     @id @default(cuid())
  name           String     @unique
  type           WalletType
  accountNo      String?
  openingBalance Decimal    @default(0) @db.Decimal(12, 2)
  // Midnight (Dhaka) of the day the opening balance was counted. Money dated
  // before it is already inside the opening balance.
  openingDate    DateTime
  isActive       Boolean    @default(true)
  sortOrder      Int        @default(0)
  note           String?

  payments          Payment[]
  expenses          Expense[]
  entries           WalletEntry[]
  courierStatements CourierStatement[]
  adSpends          DailyAdSpend[]
  cashDrawers       CashDrawer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wallets")
}

// Money in or out of a wallet that isn't a payment, refund, expense or
// courier payout: an owner's cash top-up, a bank charge, a transfer between
// wallets (two rows sharing transferId). Voided, never deleted.
model WalletEntry {
  id          String          @id @default(cuid())
  walletId    String
  wallet      Wallet          @relation(fields: [walletId], references: [id])
  type        WalletEntryType
  // Always positive (DB CHECK); the type says which way it moved.
  amount      Decimal         @db.Decimal(12, 2)
  entryDate   DateTime
  note        String
  transferId  String?
  createdById String?
  createdBy   User?           @relation("WalletEntryCreatedBy", fields: [createdById], references: [id])
  voidedAt    DateTime?
  voidReason  String?
  createdAt   DateTime        @default(now())

  @@index([walletId, entryDate])
  @@index([transferId])
  @@map("wallet_entries")
}

// PRD §4.12 — one row per day's ad spend (per platform). Each posts exactly
// one "Ad cost" expense (Expense.adSpendId, unique) so it reaches the
// wallet, the expense report and P&L once; the per-order allocation reads
// this table (lib/expenses/ad-allocation.ts).
model DailyAdSpend {
  id          String     @id @default(cuid())
  // Midnight (Dhaka) of the day the money was spent, as UTC.
  spendDate   DateTime
  platform    AdPlatform @default(FACEBOOK)
  amount      Decimal    @db.Decimal(12, 2)
  walletId    String
  wallet      Wallet     @relation(fields: [walletId], references: [id])
  note        String?
  expense     Expense?
  createdById String?
  createdBy   User?      @relation("AdSpendCreatedBy", fields: [createdById], references: [id])
  deletedAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([spendDate])
  @@map("daily_ad_spend")
}

// ---------------------------------------------------------------------------
// PRD §4.9 — Courier & delivery: Steadfast integration, shipments, courier
// cost, and the courier return condition check (P2.2)
// ---------------------------------------------------------------------------

enum CourierProvider {
  STEADFAST
}

// Where a courier status reached us from. API = the raw create-order
// response logged at booking time (undocumented fields stay discoverable).
enum ShipmentEventSource {
  WEBHOOK
  POLL
  API
}

// What the parcel is doing INSIDE the courier while the order status sits
// at IN_TRANSIT. The *_APPROVAL_PENDING values are Gift Valy's Round 2 §2.6
// lesson: the rider has marked the parcel, but the hub hasn't approved it
// yet (COD not in our balance), so the order must not move on.
enum ShipmentSubStatus {
  PENDING
  DELIVERY_APPROVAL_PENDING
  PARTIAL_DELIVERY_APPROVAL_PENDING
  RETURN_APPROVAL_PENDING
}

enum ReturnInspectionSource {
  COURIER_RETURN
  PARTIAL_DELIVERY
  CUSTOMER_RETURN
  EXCHANGE
}

enum ReturnInspectionStatus {
  // Partial delivery only: waiting for staff to say which items were kept.
  AWAITING_KEPT_ITEMS
  // The goods are on their way back / at the door: Packing to check them.
  PENDING
  COMPLETED
}

// CORRECTIONS Courier §1 — what WE pay the courier, per zone: `baseRate`
// covers the first kilogram, `perKgRate` each further started kilogram.
// Separate from CourierZone.charge, which is what the CUSTOMER is charged
// for delivery (and is often waived). Cost data: stripped for roles without
// product.cost.view.
model CourierCostRate {
  id        String         @id @default(cuid())
  courierId String
  courier   CourierCompany @relation(fields: [courierId], references: [id], onDelete: Cascade)
  zone      DeliveryZone
  baseRate  Decimal        @default(0) @db.Decimal(10, 2)
  perKgRate Decimal        @default(0) @db.Decimal(10, 2)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([courierId, zone])
  @@map("courier_cost_rates")
}

// One row per integrated courier. Every secret column is AES-256-GCM
// ciphertext under COURIER_ENCRYPTION_KEY (lib/courier/crypto.ts) and is
// only ever decrypted server-side; the browser gets a masked view.
model CourierIntegration {
  id                    String          @id @default(cuid())
  courierId             String          @unique
  courier               CourierCompany  @relation(fields: [courierId], references: [id], onDelete: Cascade)
  provider              CourierProvider @unique
  apiKeyEncrypted       String?
  secretKeyEncrypted    String?
  webhookTokenEncrypted String?
  isEnabled             Boolean         @default(false)
  pollingMinutes        Int             @default(15)
  connectedAt           DateTime?
  lastBalance           Decimal?        @db.Decimal(12, 2)
  lastBalanceAt         DateTime?
  lastSyncAt            DateTime?
  lastWebhookAt         DateTime?
  // P2.2b payouts sync: when it last ran, and the /payments page the newest
  // payouts were last found on (the list is oldest-first with no paging metadata).
  lastPaymentsSyncAt    DateTime?
  paymentsLastPage      Int             @default(1)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@map("courier_integrations")
}

// PRD §4.9 — one shipment per order (orderId is unique: that IS the
// database-level double-send guard). A row with bookedAt = null is a
// booking claim taken just before the courier API call, so two concurrent
// "Send" clicks can't both reach the courier.
model Shipment {
  id        String         @id @default(cuid())
  orderId   String         @unique
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  courierId String
  courier   CourierCompany @relation(fields: [courierId], references: [id])

  consignmentId   String?            @unique
  trackingCode    String?
  trackingUrl     String?
  // Exactly what the courier last reported, lowercased (e.g. "in_review",
  // "delivered_approval_pending"). The order status is the mapped view.
  steadfastStatus String?
  subStatus       ShipmentSubStatus?
  onHold          Boolean            @default(false)
  needsAttention  Boolean            @default(false)
  attentionReason String?

  zone                DeliveryZone?
  weightGrams         Int?
  codAmount           Decimal       @default(0) @db.Decimal(12, 2)
  // Cost fields — stripped for roles without product.cost.view. The actual
  // (from the courier webhook's delivery_charge) always wins over the
  // zone+weight estimate for P&L (lib/courier/cost.ts effectiveCourierCost).
  courierCostEstimate Decimal?      @db.Decimal(10, 2)
  courierCostActual   Decimal?      @db.Decimal(10, 2)

  // COD the courier reports as collected at the door (delivered / partial),
  // and when the courier actually paid it out to us (COD reconciliation).
  codCollected  Decimal?  @db.Decimal(12, 2)
  codReceivedAt DateTime?

  // Partial delivery: flagged for ACCOUNTS until someone reviews the money.
  accountsReviewRequired Boolean   @default(false)
  accountsReviewedAt     DateTime?
  accountsReviewedById   String?
  accountsReviewedBy     User?     @relation("ShipmentAccountsReviewedBy", fields: [accountsReviewedById], references: [id])

  bookedAt     DateTime?
  bookedById   String?
  bookedBy     User?     @relation("ShipmentBookedBy", fields: [bookedById], references: [id])
  inTransitAt  DateTime?
  deliveredAt  DateTime?
  returnedAt   DateTime?
  // Set once the courier reports a FINAL status (delivered / partial /
  // cancelled after hub approval). Polling skips finalized shipments.
  finalizedAt  DateTime?
  // Last webhook or poll that touched this shipment, and last poll alone.
  lastStatusAt DateTime?
  lastPolledAt DateTime?

  statusLogs        ShipmentStatusLog[]
  trackingEvents    ShipmentTrackingEvent[]
  statementLines    CourierStatementLine[]
  returnInspections ReturnInspection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courierId])
  @@index([finalizedAt])
  @@index([needsAttention])
  @@map("shipments")
}

// Every status payload we ever received (webhook or poll) or sent back
// from the create call, verbatim — the audit trail and the only way to
// diagnose courier-side surprises. shipmentId is null for payloads whose
// consignment we couldn't match.
model ShipmentStatusLog {
  id         String              @id @default(cuid())
  shipmentId String?
  shipment   Shipment?           @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  source     ShipmentEventSource
  rawStatus  String?
  rawPayload Json
  receivedAt DateTime            @default(now())

  @@index([shipmentId, receivedAt])
  @@index([receivedAt])
  @@map("shipment_status_logs")
}

// Steadfast's `tracking_update` webhook: free-text timeline entries, no
// status change. eventAt is the courier's own timestamp (Asia/Dhaka local
// on the wire, stored UTC — CORRECTIONS Round 2 §2.5).
model ShipmentTrackingEvent {
  id         String              @id @default(cuid())
  shipmentId String
  shipment   Shipment            @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  message    String
  eventAt    DateTime
  source     ShipmentEventSource
  createdAt  DateTime            @default(now())

  @@index([shipmentId, eventAt])
  @@map("shipment_tracking_events")
}

// PRD §4.9 / §4.11 — the Packing condition check for goods coming back:
// Good → back on the shelf (RETURN_IN / EXCHANGE_IN), Damaged → DAMAGE_OUT
// write-off with an expense at cost. lib/returns/condition-check.ts is the
// one service that completes these; courier returns, partial deliveries
// and (Phase 3) exchanges all create a row here and call it.
model ReturnInspection {
  id         String                 @id @default(cuid())
  orderId    String
  order      Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  shipmentId String?
  shipment   Shipment?              @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  source     ReturnInspectionSource
  status     ReturnInspectionStatus @default(PENDING)

  keptItemsMarkedAt   DateTime?
  keptItemsMarkedById String?
  keptItemsMarkedBy   User?     @relation("ReturnKeptItemsMarkedBy", fields: [keptItemsMarkedById], references: [id])

  inspectedAt   DateTime?
  inspectedById String?
  inspectedBy   User?     @relation("ReturnInspectedBy", fields: [inspectedById], references: [id])
  note          String?

  lines               ReturnInspectionLine[]
  returnChargeExpense Expense?               @relation("ReturnChargeExpense")
  returnCase          ReturnCase?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
  @@map("return_inspections")
}

model ReturnInspectionLine {
  id           String           @id @default(cuid())
  inspectionId String
  inspection   ReturnInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  orderItemId  String
  orderItem    OrderItem        @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  // Units expected back, then how the inspector split them.
  qty          Int
  goodQty      Int              @default(0)
  damagedQty   Int              @default(0)

  @@unique([inspectionId, orderItemId])
  @@map("return_inspection_lines")
}

// ---------------------------------------------------------------------------
// PRD §4.9 — COD reconciliation and courier payouts (P2.2b)
// ---------------------------------------------------------------------------

enum CourierStatementSource {
  STEADFAST_API
  CSV_IMPORT
  MANUAL
}

// Steadfast's payout lifecycle is processing → paid. Only a PAID statement
// moves money; a processing one is shown but never settles anything.
enum CourierStatementStatus {
  PROCESSING
  PAID
}

enum CourierStatementLineStatus {
  // Statement not paid yet — nothing judged.
  PENDING
  // Their figures agree with ours (±৳2): the order's COD was settled.
  MATCHED
  // Their figures differ from ours: no money moved; waiting for Accounts.
  MISMATCH
  // A consignment we can't match to any of our shipments.
  UNMATCHED
  // Accounts accepted the courier's figure (reason recorded): settled.
  ACCEPTED
  // Accounts disputed it with the courier: nothing moves.
  DISPUTED
}

// One courier statement / payout — a Steadfast payout pulled from its API, or
// a statement Accounts imported (CSV) or typed in. Every taka that reaches the
// bank is justified line by line against our orders:
//   gross COD − delivery charges − COD charges = net paid out
model CourierStatement {
  id            String                 @id @default(cuid())
  courierId     String
  courier       CourierCompany         @relation(fields: [courierId], references: [id])
  source        CourierStatementSource
  // The courier's own reference (Steadfast "SFC-30820783", a CSV's statement
  // number). Unique per courier: re-syncing or re-importing never duplicates.
  reference     String
  status        CourierStatementStatus @default(PAID)
  statementDate DateTime

  grossAmount    Decimal @default(0) @db.Decimal(12, 2)
  deliveryCharge Decimal @default(0) @db.Decimal(12, 2)
  codCharge      Decimal @default(0) @db.Decimal(12, 2)
  netAmount      Decimal @default(0) @db.Decimal(12, 2)
  // The wallet the courier paid the net into — this statement's net is that
  // wallet's inflow (the COD payments themselves carry no wallet).
  walletId       String?
  wallet         Wallet? @relation(fields: [walletId], references: [id], onDelete: Restrict)
  note           String?

  rawPayload       Json?
  rawDetailPayload Json?

  // Set once every line is MATCHED/ACCEPTED: the charges are posted as
  // expenses exactly once (unique FKs) and the statement is reconciled.
  reconciledAt            DateTime?
  deliveryChargeExpenseId String?   @unique
  deliveryChargeExpense   Expense?  @relation("StatementDeliveryChargeExpense", fields: [deliveryChargeExpenseId], references: [id], onDelete: Restrict)
  codChargeExpenseId      String?   @unique
  codChargeExpense        Expense?  @relation("StatementCodChargeExpense", fields: [codChargeExpenseId], references: [id], onDelete: Restrict)

  createdById String?
  createdBy   User?   @relation("CourierStatementCreatedBy", fields: [createdById], references: [id])

  lines CourierStatementLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courierId, reference])
  @@index([statementDate])
  @@map("courier_statements")
}

model CourierStatementLine {
  id          String           @id @default(cuid())
  statementId String
  statement   CourierStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  // Row order within the statement (stable dedupe key when a line has no consignment id).
  lineNo      Int

  // As the courier reported it.
  consignmentId  String?
  invoice        String?
  codAmount      Decimal  @db.Decimal(12, 2)
  deliveryCharge Decimal? @db.Decimal(12, 2)
  codCharge      Decimal? @db.Decimal(12, 2)

  // What we matched it to.
  shipmentId String?
  shipment   Shipment? @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  orderId    String?
  order      Order?    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  status         CourierStatementLineStatus @default(PENDING)
  // Frozen when judged: our COD, our computed net receivable, and their net
  // for this parcel when it can be derived.
  ourCod         Decimal?                   @db.Decimal(12, 2)
  expectedNet    Decimal?                   @db.Decimal(12, 2)
  paidNet        Decimal?                   @db.Decimal(12, 2)
  mismatchReason String?

  // The order payment this line created (unique: never settled twice).
  paymentId String?  @unique
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  resolvedById String?
  resolvedBy   User?     @relation("CourierStatementLineResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt   DateTime?
  resolveNote  String?

  rawPayload Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([statementId, lineNo])
  @@index([shipmentId])
  @@index([orderId])
  @@index([status])
  @@map("courier_statement_lines")
}

// ---------------------------------------------------------------------------
// PRD §4.7 — POS: the showroom cash drawer (P3.1)
// ---------------------------------------------------------------------------

enum CashDrawerStatus {
  OPEN
  CLOSED
}

// One row per business day for the showroom cash wallet. The drawer IS that
// wallet's physical cash: what should be in it is the opening count plus the
// wallet's money in and out that day (lib/pos/drawer.ts). Closing it counts
// the cash, verifies the day's cash payments (the count is the proof) and
// posts any difference once as a "Cash over/short" expense from the wallet,
// so the wallet's balance follows the counted cash. A partial unique index
// (migration) allows only one OPEN drawer per wallet at a time.
model CashDrawer {
  id          String           @id @default(cuid())
  walletId    String
  wallet      Wallet           @relation(fields: [walletId], references: [id], onDelete: Restrict)
  // Midnight (Dhaka) of the business day, as UTC.
  businessDay DateTime
  status      CashDrawerStatus @default(OPEN)

  openedAt             DateTime @default(now())
  openedById           String?
  openedBy             User?    @relation("CashDrawerOpenedBy", fields: [openedById], references: [id])
  openingCount         Decimal  @db.Decimal(12, 2)
  // { "1000": 2, "500": 3, ... } — note/coin counts, if counted that way.
  openingDenominations Json?
  // Required when the opening count differs from the last counted close.
  openingNote          String?
  // What the wallet's books said when the drawer opened — the gap between
  // this and the count is shown, never posted (opening cash may be a top-up).
  bookBalanceAtOpen    Decimal  @db.Decimal(12, 2)

  closedAt             DateTime?
  closedById           String?
  closedBy             User?     @relation("CashDrawerClosedBy", fields: [closedById], references: [id])
  closingCount         Decimal?  @db.Decimal(12, 2)
  closingDenominations Json?
  // Frozen at close: opening + the day's cash in − cash out.
  expectedClose        Decimal?  @db.Decimal(12, 2)
  // closingCount − expectedClose. Negative = short, positive = over.
  difference           Decimal?  @db.Decimal(12, 2)
  // Required when there is a difference.
  closeNote            String?

  overShortExpense Expense?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([walletId, businessDay])
  @@index([status])
  @@map("cash_drawers")
}

// ---------------------------------------------------------------------------
// PRD §4.11 — returns and exchanges (P3.2)
// ---------------------------------------------------------------------------

enum ReturnCaseType {
  RETURN
  EXCHANGE
}

// ONLINE: requested, approved, then PENDING until the item is physically
// back and checked. COUNTER: the customer is at the showroom with the item —
// inspected and settled on the spot, created COMPLETED in one transaction.
enum ReturnCaseMode {
  ONLINE
  COUNTER
}

enum ReturnCaseStatus {
  // Waiting for a TL/Manager/Admin (return.approve / exchange.approve).
  REQUESTED
  // Approved: money and the replacement are set up; waiting for the item to
  // come back and pass the Packing condition check. No stock has moved.
  APPROVED
  COMPLETED
  REJECTED
  CANCELLED
}

enum ReturnReason {
  WRONG_SIZE
  WRONG_COLOR
  NOT_AS_EXPECTED
  DEFECTIVE
  OTHER
}

enum CourierChargeBearer {
  CUSTOMER
  COMPANY
}

model ReturnCase {
  id     String           @id @default(cuid())
  type   ReturnCaseType
  mode   ReturnCaseMode
  status ReturnCaseStatus @default(REQUESTED)

  orderId            String
  order              Order   @relation("ReturnCaseOrder", fields: [orderId], references: [id], onDelete: Restrict)
  // Exchanges: the linked order carrying the replacement (its
  // exchangedFromOrderId points back at `orderId`). Set on approval.
  replacementOrderId String? @unique
  replacementOrder   Order?  @relation("ReturnCaseReplacement", fields: [replacementOrderId], references: [id], onDelete: Restrict)

  reason              ReturnReason
  reasonNote          String?
  // Online exchanges only (DB CHECK): who pays the replacement's courier.
  courierChargeBearer CourierChargeBearer?
  // What the customer is owed back goes as a refund (P2.3 approval flow) or
  // as store credit, issued once the item is back and checked. A counter
  // exchange is always STORE_CREDIT: the customer has left by then.
  settlement          ReturnSettlement     @default(REFUND)
  // Set on approval: what the case left owed to the customer on the
  // original order (returned value less exchange credit carried to the
  // replacement). Caps the store credit issued when the case completes.
  owedAmount          Decimal?             @db.Decimal(12, 2)

  // The original order's status before approval moved it (to RETURNED or
  // EXCHANGE_REQUESTED) — where cancelling puts it back.
  orderStatusBefore OrderStatus?
  // The Packing condition check for the items coming back
  // (lib/returns/condition-check.ts), opened on approval.
  inspectionId      String?           @unique
  inspection        ReturnInspection? @relation(fields: [inspectionId], references: [id], onDelete: Restrict)

  requestedById String?
  requestedBy   User?     @relation("ReturnCaseRequestedBy", fields: [requestedById], references: [id])
  decidedById   String?
  decidedBy     User?     @relation("ReturnCaseDecidedBy", fields: [decidedById], references: [id])
  decidedAt     DateTime?
  decisionNote  String?
  cancelledById String?
  cancelledBy   User?     @relation("ReturnCaseCancelledBy", fields: [cancelledById], references: [id])
  cancelledAt   DateTime?
  cancelNote    String?
  completedAt   DateTime?

  lines              ReturnCaseLine[]
  payments           Payment[]
  courierCostExpense Expense?           @relation("ExchangeCourierCostExpense")
  storeCreditEntries StoreCreditEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([type, createdAt])
  @@map("return_cases")
}

model ReturnCaseLine {
  id          String     @id @default(cuid())
  caseId      String
  returnCase  ReturnCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  // Units of that line coming back.
  qty         Int

  // Exchanges: what the customer gets instead, one for one.
  replacementVariantId String?
  replacementVariant   ProductVariant? @relation(fields: [replacementVariantId], references: [id], onDelete: Restrict)

  @@unique([caseId, orderItemId])
  @@index([replacementVariantId])
  @@map("return_case_lines")
}

// ============ Store credit (P3.2) ============
// PRD §4.11 / §4.12. What the shop owes a customer, to spend on a later
// order. A liability: issuing it is not income or expense, and it becomes
// revenue only when spent (as part of that order's total).

enum ReturnSettlement {
  REFUND
  STORE_CREDIT
}

enum StoreCreditEntryType {
  // Credited out of an order the customer overpaid (an exchange for
  // something cheaper, a return settled as credit).
  ISSUED
  // Spent on an order.
  USED
  // Given back: the order it was spent on was cancelled, or the use undone.
  RESTORED
  // Admin correction, reason required.
  ADJUSTED
}

model StoreCreditEntry {
  id         String               @id @default(cuid())
  customerId String
  customer   Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  type       StoreCreditEntryType
  // + adds to the balance, − takes from it (DB CHECK by type).
  amount     Decimal              @db.Decimal(12, 2)
  // Credit added while an expiry was set (Settings) lapses at this moment;
  // null = never. Only on rows that add credit (DB CHECK).
  expiresAt  DateTime?

  // Every row but an adjustment moves credit through an order, as exactly
  // one STORE_CREDIT payment row on it (DB CHECK).
  orderId      String?
  order        Order?      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentId    String?     @unique
  payment      Payment?    @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  returnCaseId String?
  returnCase   ReturnCase? @relation(fields: [returnCaseId], references: [id], onDelete: Restrict)

  reason      String?
  createdById String?
  createdBy   User?    @relation("StoreCreditEntryCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([customerId, createdAt])
  @@index([createdAt])
  @@index([orderId])
  @@map("store_credit_entries")
}

// ============ Outfit sets and packaging (P3.3) ============
// PRD §4.2. A set is built from PRODUCTS, not fixed variants: "Kurti +
// Dupatta + Plazo" is one set, and the size and colour of each component
// is chosen when it is sold.

enum ProductKind {
  SELLABLE
  COMPONENT_ONLY
}

model OutfitSet {
  id          String  @id @default(cuid())
  name        String
  description String?
  // Set independently of the components' prices.
  price       Decimal @db.Decimal(12, 2)
  isActive    Boolean @default(true)

  components OutfitSetComponent[]
  packaging  PackagingComponent[] @relation("OutfitSetPackaging")
  orderLines OrderSetLine[]

  createdById String?
  createdBy   User?   @relation("OutfitSetCreatedBy", fields: [createdById], references: [id])

  // CLAUDE.md rule 8: soft delete only.
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([deletedAt])
  @@map("outfit_sets")
}

model OutfitSetComponent {
  id        String    @id @default(cuid())
  setId     String
  set       OutfitSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  // Units of this product in one set: drives cost, stock and availability.
  qty       Int
  sortOrder Int       @default(0)

  @@unique([setId, productId])
  @@index([productId])
  @@map("outfit_set_components")
}

enum PackagingScope {
  // Every online parcel, whatever is in it (a mailer bag).
  ONLINE_PARCEL
  // Every showroom sale (a shopping bag).
  POS_SALE
}

// Packaging a unit of a product or set uses, or every parcel / counter sale
// uses. Exactly one owner (DB CHECK). The material is a variant of a
// COMPONENT_ONLY product.
model PackagingComponent {
  id                String          @id @default(cuid())
  productId         String?
  product           Product?        @relation("ProductPackaging", fields: [productId], references: [id], onDelete: Cascade)
  outfitSetId       String?
  outfitSet         OutfitSet?      @relation("OutfitSetPackaging", fields: [outfitSetId], references: [id], onDelete: Cascade)
  scope             PackagingScope?
  materialVariantId String
  materialVariant   ProductVariant  @relation("PackagingMaterial", fields: [materialVariantId], references: [id], onDelete: Restrict)
  qty               Int

  createdAt DateTime @default(now())

  @@unique([productId, materialVariantId])
  @@unique([outfitSetId, materialVariantId])
  @@unique([scope, materialVariantId])
  @@index([materialVariantId])
  @@map("packaging_components")
}

// An outfit set sold on an order. Its components are ordinary order_items
// (setLineId), each the chosen size/colour with its share of the price, so
// the order total is still the sum of order_items.
model OrderSetLine {
  id           String    @id @default(cuid())
  orderId      String
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  outfitSetId  String
  outfitSet    OutfitSet @relation(fields: [outfitSetId], references: [id], onDelete: Restrict)
  // The set's name when sold (printed on the invoice even if renamed later).
  name         String
  qty          Int
  unitPrice    Decimal   @db.Decimal(12, 2)
  lineDiscount Decimal   @default(0) @db.Decimal(12, 2)

  items OrderItem[]

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([outfitSetId])
  @@map("order_set_lines")
}
