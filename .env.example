# Antu Boutique CRM — environment variables
# Copy to .env and fill in. Never commit .env. Never reuse Gift Valy's values.

# --- Database (fresh Neon project, separate from Gift Valy) ---
DATABASE_URL=""          # Neon pooled connection string
DIRECT_URL=""            # Neon direct (non-pooler) connection string, used by migrations
SHADOW_DATABASE_URL=""   # Throwaway DB on the same Neon server (e.g. .../antu_shadow) — Prisma WIPES it
                         # when generating migrations. NEVER the same database as DATABASE_URL/DIRECT_URL.
TEST_DATABASE_URL=""     # Integration tests ONLY (e.g. .../antu_test on the same Neon server). `npm test` refuses to
                         # run against anything else: the database name must end in _test.

# --- Auth ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""       # openssl rand -base64 32

# --- Courier (Steadfast) ---
# Encrypts the courier API credentials stored in the database.
# Once live, changing this breaks the courier integration until credentials are re-entered.
COURIER_ENCRYPTION_KEY=" "  # openssl rand -hex 32

# Safety switch for the Steadfast API. Unless this is exactly "enabled", the app
# refuses to book consignments or call the status API (Test Connection / balance
# still work). Set it ONLY on the production server — never on a dev machine.
STEADFAST_LIVE_API=""

# --- Cron jobs (status sync, trash purge, backup, low-stock alert) ---
CRON_SECRET=""           # openssl rand -hex 32

# --- Backups (scripts/backup.sh — see docs/BACKUPS.md) ---
BACKUP_DIR="/var/backups/antu-crm"   # where the nightly dumps go; kept BACKUP_RETENTION_DAYS days
BACKUP_RETENTION_DAYS="14"
BACKUP_RCLONE_REMOTE=""              # optional off-server copy, e.g. "b2:antu-backups" (rclone remote)
BACKUP_REPORT_URL=""                 # the app's URL the script reports to; defaults to NEXTAUTH_URL
# PG_DUMP="/usr/lib/postgresql/18/bin/pg_dump"   # only if the default pg_dump is older than the server (Neon: PostgreSQL 18)

# --- Uploads (product images + order reference images) ---
UPLOAD_DIR="./public/uploads"
MAX_UPLOAD_MB="5"

# --- Locale ---
TZ="Asia/Dhaka"
